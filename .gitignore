# Generated by ./build.sh from the artefacts; never edited, never committed.
build-info.json
# Acceptance screenshots, filed per SDK revision by tools/two-tab.mjs. They
# are EVIDENCE FOR A RUN, not for the repo: a new directory of them appears
# on every SDK_REV bump, and the ones worth keeping are copied into docs/
# deliberately, with the revision in the commit that puts them there.
shots/
